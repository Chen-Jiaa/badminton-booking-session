# Database
DATABASE_URL="postgresql://user:password@localhost:5432/badminton"

# Supabase
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# Server only: receipt storage (private bucket). Never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Web Push (VAPID) — generate a key pair with: npx web-push generate-vapid-keys
# The public key is exposed to the browser; the private key stays server-only.
VITE_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# Cron
CRON_SECRET=""

# Resend (email delivery)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Google Sheets sync (Apps Script Web App /exec URL — appends confirmed top-ups)
GOOGLE_SHEET_WEBHOOK_URL=""
